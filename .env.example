# ===== Supabase (opsional — tanpa ini aplikasi berjalan dalam "Mode Tamu" dengan penyimpanan lokal) =====
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Hanya dipakai di server (API route hapus akun). JANGAN pernah diawali NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ===== Lapisan LLM opsional untuk penjelasan rekomendasi (server-side saja) =====
ANTHROPIC_API_KEY=
# Default: claude-opus-5-5
ANTHROPIC_MODEL=claude-opus-5-5

# ===== MediaPipe =====
# Lokasi file WASM (otomatis disalin ke /public/mediapipe/wasm saat npm install)
NEXT_PUBLIC_MEDIAPIPE_WASM_URL=/mediapipe/wasm
# Kosongkan untuk memakai model resmi dari storage.googleapis.com.
# Isi "/models" setelah menjalankan `npm run models:download` untuk self-host.
NEXT_PUBLIC_MEDIAPIPE_MODEL_BASE=

# URL publik aplikasi (dipakai untuk redirect OAuth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
